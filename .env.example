# Copy to .env (git-ignored) and fill in. Never commit real values.

# Phone pairing code shown on the dashboard. Empty = a new code is generated at every server start.
# A fixed code is convenient for the simulator, which reads it from here too.
DUO_PAIR_CODE=

# Dashboard access code for other devices (used from M8). Empty = generated at start.
DUO_ACCESS_CODE=

# Groq API key for the explainer (M7).
GROQ_API_KEY=
